{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PywrScope",
  "version": "1.7.4",
  "identifier": "com.pywrscope",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PywrScope",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self' asset: http://asset.localhost 'unsafe-inline' 'unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/python-runtime/**/*"
    ],
    "icon": [
      "icons/icon_32.png",
      "icons/icon_128.png",
      "icons/icon_256.png",
      "icons/icon_512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
